# Copy to .env for local development. Nothing here is required: with an
# empty file the site runs, builds and serves — the review section simply
# reports that it is unavailable, which is the truth when there is no
# database behind it.

# ---------------------------------------------------------------- write side

# Postgres. Neon's free tier is what this is sized for; any Postgres works.
# Use the POOLED connection string (the host contains "-pooler") — serverless
# functions open a connection per cold start and the pooler is what absorbs
# that. Apply db/schema.sql once before first use:  npm run db:schema
DATABASE_URL=

# Resend API key, for the login links. Leave empty in development: the link
# is printed to the server log instead of sent, so the whole flow is walkable
# with no account anywhere.
RESEND_API_KEY=

# Must be an address at a domain verified in Resend, or mail is rejected.
MAIL_FROM=yalp.uz <kirish@yalp.uz>

# ------------------------------------------------------------------- the site

# Absolute, with scheme. Magic links and canonical tags are built from it, so
# a wrong value here sends people to the wrong host.
NUXT_PUBLIC_SITE_URL=https://yalp.uz

# Let search engines in. Off by default — see nuxt.config.ts.
NUXT_PUBLIC_INDEXABLE=false

# GoatCounter site code, e.g. "yalp". Empty means no analytics loads at all.
NUXT_PUBLIC_ANALYTICS=

# Set to "static" to produce the GitHub Pages build instead of the Vercel one.
# NITRO_PRESET=static
